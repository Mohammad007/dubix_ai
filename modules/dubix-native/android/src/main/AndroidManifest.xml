<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Optional one-time model pack downloads. All inference runs on device. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- Live translator (microphone) and AudioPlaybackCapture both need RECORD_AUDIO. -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Floating controller over other apps; user must grant it in system settings. -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <application>
    <service
      android:name="ai.dubix.engine.live.LiveCaptureService"
      android:exported="false"
      android:foregroundServiceType="mediaProjection|microphone" />
  </application>
</manifest>
